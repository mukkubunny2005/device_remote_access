# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./remote_access.db
# For PostgreSQL (Phase 6):
# DATABASE_URL=postgresql://user:password@localhost:5432/remote_access

# ─────────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────────
#  CORS — comma-separated list of allowed origins
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# ─────────────────────────────────────────────
#  FCM (Phase 3)
# ─────────────────────────────────────────────
FCM_SERVER_KEY=

# ─────────────────────────────────────────────
#  Access request expiry (seconds)
# ─────────────────────────────────────────────
ACCESS_REQUEST_EXPIRE_SECONDS=120
